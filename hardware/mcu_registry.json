{
  "version": "2.0.0",
  "sensor_mcu_ids": "__all__",
  "workarounds": {
    "esp32c6": {
      "use_target": "esp32c3",
      "env": "esp32c3",
      "kind": "flash_alias",
      "summary": "Flash esp32c3 firmware - same HERMES JSON serial protocol on ESP32-C6 boards"
    },
    "esp32p4": {
      "use_target": "esp32s3",
      "env": "esp32s3",
      "path": "hardware/esp32s3-pio",
      "kind": "flash_alias",
      "summary": "Flash esp32s3 build until espressif32 adds P4 Arduino support"
    },
    "rtl8720": {
      "use_target": "rtl8710",
      "env": "rtl8710",
      "kind": "flash_alias",
      "summary": "RTL8720 (AmebaZ2): use rtl8710 LibreTiny build - same Tuya/WBR module family"
    },
    "lpc1768": {
      "use_target": "stm32f4",
      "env": "stm32f4",
      "kind": "flash_alias",
      "summary": "LPC1768 has no Arduino PIO - use stm32f4 node firmware on ARM Cortex-M boards"
    },
    "nrf5340": {
      "use_target": "nrf52840",
      "env": "nrf52840",
      "path": "hardware/nrf52840-pio",
      "kind": "flash_alias",
      "summary": "nRF5340 needs Zephyr SDK - nrf52840 build covers Nordic BLE node apps"
    },
    "nrf53": {
      "use_target": "nrf52840",
      "env": "nrf52840",
      "path": "hardware/nrf52840-pio",
      "kind": "flash_alias",
      "summary": "Same as nrf5340 - use nrf52840 firmware"
    },
    "nrf51": {
      "use_target": "nrf52832",
      "env": "nrf52832",
      "kind": "flash_alias",
      "summary": "Legacy nRF51 - flash nrf52832 HERMES node"
    },
    "efr32": {
      "use_target": "nrf52840",
      "env": "nrf52840",
      "path": "hardware/nrf52840-pio",
      "kind": "runtime_alias",
      "summary": "Silabs PIO unavailable on Windows - use nrf52840 for Zigbee gateway host; EFR32 as UART coprocessor (see stubs/efr32)"
    },
    "kinetis": {
      "use_target": "imxrt",
      "env": "imxrt",
      "kind": "flash_alias",
      "summary": "Kinetis: use Teensy 4.x / imxrt build"
    },
    "rx": {
      "use_target": "ra",
      "env": "renesas_ra",
      "kind": "flash_alias",
      "summary": "Renesas RX - use RA (UNO R4) build"
    },
    "pic16": {
      "use_target": "pic32",
      "env": "pic32",
      "kind": "stub_port",
      "summary": "Port hardware/stubs/generic_node.c to MPLAB X; reference pic32 PIO build"
    },
    "pic18": {
      "use_target": "pic32",
      "env": "pic32",
      "kind": "stub_port",
      "summary": "Same as pic16 - generic_node.c template"
    },
    "stm8": {
      "use_target": "stm32f1",
      "env": "stm32f1",
      "kind": "stub_port",
      "summary": "STM8: port generic_node.c via STVD; stm32f1 for similar 8-bit UART nodes"
    },
    "xr809": {
      "use_target": "rtl8710",
      "env": "rtl8710",
      "kind": "flash_alias",
      "summary": "XR809 WiFi - use rtl8710 LibreTiny build"
    },
    "cc2530": {
      "kind": "coprocessor",
      "summary": "Zigbee coordinator dongle - flash Z-Stack, link via serial-bridge (not HERMES node FW)"
    },
    "cc2531": {
      "kind": "coprocessor",
      "summary": "USB Zigbee coordinator - Z-Stack + serial-bridge"
    },
    "cc2652": {
      "kind": "coprocessor",
      "summary": "TI Z-Stack 3 coordinator - UART to control plane"
    },
    "cc26xx": {
      "kind": "coprocessor",
      "summary": "TI SimpleLink coprocessor - see hardware/stubs/ti_cc"
    },
    "efr32mg12": {
      "kind": "coprocessor",
      "summary": "Silicon Labs Zigbee NCP - Spinel/UART to cluster"
    },
    "efr32mg21": {
      "kind": "coprocessor",
      "summary": "EFR32 MG21 Zigbee coprocessor"
    },
    "stm32h5": {
      "use_target": "stm32h7",
      "env": "stm32h7",
      "path": "hardware/stm32h7-pio",
      "kind": "flash_alias",
      "summary": "STM32H5 - use stm32h7 build until nucleo_h563 env is verified"
    },
    "stm32l4": {
      "use_target": "stm32f4",
      "env": "stm32f4",
      "kind": "flash_alias",
      "summary": "STM32L4 - use stm32f4 build (same HERMES STM32 node)"
    },
    "stm32u5": {
      "use_target": "stm32h7",
      "env": "stm32h7",
      "path": "hardware/stm32h7-pio",
      "kind": "flash_alias",
      "summary": "STM32U5 ultra-low-power - use stm32h7 build for bring-up"
    },
    "stm32wb": {
      "use_target": "stm32f4",
      "env": "stm32f4",
      "kind": "flash_alias",
      "summary": "STM32WB BLE - use stm32f4 node; add BLE coprocessor separately"
    }
  },
  "targets": {
