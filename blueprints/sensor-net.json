{
  "id": "sensor-net",
  "name": "Sensor Network",
  "description": "Multi-sensor mesh with local + remote nodes",
  "version": "1.1.0",
  "memory": "64KB",
  "priority": 4,
  "fields": [
    {
      "key": "network_name",
      "label": "Network name",
      "type": "text",
      "default": "Sensor Net 1",
      "required": true
    },
    {
      "key": "sensor_count",
      "label": "Number of sensors",
      "type": "number",
      "min": 1,
      "max": 16,
      "default": 4
    },
    {
      "key": "report_interval_sec",
      "label": "Report interval (sec)",
      "type": "number",
      "min": 5,
      "max": 3600,
      "default": 120
    },
    {
      "key": "mesh_enabled",
      "label": "Enable sensor mesh",
      "type": "toggle",
      "default": true
    },
    {
      "key": "mesh_max_nodes",
      "label": "Max remote nodes",
      "type": "number",
      "min": 1,
      "max": 8,
      "default": 4
    },
    {
      "key": "mesh_transport",
      "label": "Mesh transport",
      "type": "select",
      "default": "uart",
      "options": [
        {"value": "uart", "label": "UART (wired)"},
        {"value": "ble", "label": "BLE (nRF / ESP)"},
        {"value": "zigbee", "label": "Zigbee coprocessor"}
      ]
    },
    {
      "key": "sensors",
      "label": "Local sensors",
      "type": "sensor_list",
      "default": [
        "temp_humidity",
        "motion_pir",
        "ble_rssi",
        "accelerometer"
      ]
    },
    {
      "key": "remote_sensors",
      "label": "Remote sensor types",
      "type": "text",
      "default": "temp_humidity,motion_pir,door_contact"
    },
    {
      "key": "target_node",
      "label": "Target node",
      "type": "node",
      "default": 0
    }
  ],
  "metrics": [
    {
      "key": "active_sensors",
      "label": "Active sensors",
      "unit": ""
    },
    {
      "key": "remote_nodes",
      "label": "Remote nodes",
      "unit": ""
    },
    {
      "key": "packets_sent",
      "label": "Packets sent",
      "unit": ""
    }
  ]
}
