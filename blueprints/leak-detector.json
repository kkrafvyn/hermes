{
  "id": "leak-detector",
  "name": "Leak Detector",
  "description": "Water leak detection with optional auto shutoff",
  "version": "1.0.0",
  "memory": "64KB",
  "priority": 6,
  "fields": [
    { "key": "site_name", "label": "Site name", "type": "text", "default": "Basement", "required": true },
    { "key": "sensor_count", "label": "Leak sensors", "type": "number", "min": 1, "max": 16, "default": 2 },
    { "key": "auto_shutoff", "label": "Auto shutoff valve", "type": "toggle", "default": true },
    { "key": "alert_delay_sec", "label": "Alert delay (sec)", "type": "number", "min": 0, "max": 300, "default": 10 },
    { "key": "sensors", "label": "Sensors", "type": "sensor_list", "default": ["water_leak", "water_level", "pressure"] },
    { "key": "target_node", "label": "Target node", "type": "node", "default": 1 }
  ],
  "metrics": [
    { "key": "leak_detected", "label": "Leak detected", "type": "bool" },
    { "key": "valve_closed", "label": "Valve closed", "type": "bool" },
    { "key": "active_sensors", "label": "Active sensors", "unit": "" }
  ]
}
