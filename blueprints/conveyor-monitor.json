{
  "id": "conveyor-monitor",
  "name": "Conveyor Monitor",
  "description": "Belt conveyor vibration and motor health",
  "version": "1.0.0",
  "memory": "96KB",
  "priority": 4,
  "fields": [
    {
      "key": "line_name",
      "label": "Line Name",
      "type": "text",
      "default": "Line 3",
      "required": true
    },
    {
      "key": "vibration_alert_g",
      "label": "Vibration alert (g)",
      "type": "number",
      "default": 2,
      "min": 0.5,
      "max": 4
    },
    {
      "key": "motor_max_c",
      "label": "Motor max temp (C)",
      "type": "number",
      "default": 70,
      "min": 50,
      "max": 90
    },
    {
      "key": "sensors",
      "label": "Sensors",
      "type": "sensor_list",
      "default": [
        "vibration",
        "accelerometer",
        "current_clamp",
        "temp_humidity"
      ]
    },
    {
      "key": "target_node",
      "label": "Target node",
      "type": "node",
      "default": 1
    }
  ],
  "metrics": [
    {
      "key": "vibration_g",
      "label": "Vibration",
      "unit": "g"
    },
    {
      "key": "motor_temp_c",
      "label": "Motor temp",
      "unit": "C"
    },
    {
      "key": "fault",
      "label": "Fault",
      "type": "bool"
    }
  ]
}
