{
  "id": "vineyard",
  "name": "Vineyard Monitor",
  "description": "Vineyard soil, leaf wetness, and microclimate",
  "version": "1.0.0",
  "memory": "96KB",
  "priority": 4,
  "fields": [
    {
      "key": "zone_name",
      "label": "Zone Name",
      "type": "text",
      "default": "Block 3",
      "required": true
    },
    {
      "key": "frost_alert_c",
      "label": "Frost alert (C)",
      "type": "number",
      "default": 2,
      "min": -5,
      "max": 5
    },
    {
      "key": "irrigate_on_dry",
      "label": "Irrigate when dry",
      "type": "toggle",
      "default": true
    },
    {
      "key": "sensors",
      "label": "Sensors",
      "type": "sensor_list",
      "default": [
        "soil_moisture",
        "leaf_wetness",
        "temp_humidity",
        "lux",
        "wind_speed"
      ]
    },
    {
      "key": "target_node",
      "label": "Target node",
      "type": "node",
      "default": 1
    }
  ],
  "metrics": [
    {
      "key": "soil_moisture",
      "label": "Soil moisture",
      "unit": "%"
    },
    {
      "key": "leaf_wet",
      "label": "Leaf wetness",
      "unit": "%"
    },
    {
      "key": "frost_risk",
      "label": "Frost risk",
      "type": "bool"
    }
  ]
}
